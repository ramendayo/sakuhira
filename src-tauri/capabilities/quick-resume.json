{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-resume",
  "description": "Allow the quick resume window to load candidates, apply its theme, resume projects, close itself, and open sakuhira",
  "windows": ["quick-resume"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-projects",
    "allow-get-settings",
    "allow-apply-theme",
    "allow-resume-project",
    "allow-close-quick-resume",
    "allow-open-reentry"
  ]
}
